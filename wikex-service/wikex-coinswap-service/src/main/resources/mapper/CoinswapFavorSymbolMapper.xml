<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wikex.wikex.coinswap.mapper.CoinswapFavorSymbolMapper">

    <select id="findByMemberIdAndSymbol" resultType="com.wikex.wikex.coinswap.entity.CoinswapFavorSymbol">
        select * from coinswap_favor_symbol
        <where>
            member_id = #{memberId} and symbol = #{symbol}
        </where>
    </select>
    <select id="findAllByMemberId" resultType="com.wikex.wikex.coinswap.entity.CoinswapFavorSymbol">
        select * from coinswap_favor_symbol
        <where>
            member_id = #{memberId}
        </where>
    </select>
</mapper>
