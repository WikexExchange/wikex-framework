<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wikex.wikex.user.mapper.MemberWeightUpperMapper">

    <select id="findAllByUpperIds" resultType="com.wikex.wikex.user.entity.MemberWeightUpper">
        select * from member_weight_upper where member_id in (#{ids}) order by member_id desc
