<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wikex.wikex.user.mapper.MemberRechargeAddressMapper">

    <select id="findMemberRechargeAddressByMemberIdAndCoin" resultType="com.wikex.wikex.user.entity.MemberRechargeAddress">
        select a.* from member_recharge_address a
        left join coin_chain_info c on c.chain_id=a.chain_id
        where c.`name`= #{name} and a.member_id=#{memberId}
    </select>
</mapper>
