<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@200..800&display=swap" rel="stylesheet">
  <title>New IP Login</title>
  <style>
    body {
      font-family: "Manrope", sans-serif;
      background: #f9f9f9;
      padding: 20px;
      margin: 0;
    }

    ul {
      padding-left: 0;
    }

    ul li {
      list-style-type: none;
    }

    a {
      text-decoration: none;
    }

    figure {
      margin: 0;
    }

    img {
      max-width: 100%;
      height: 100%;
    }

    p {
      font-weight: 500;
      font-size: 14px;
    }

    .container {
      max-width: 600px;
      margin: auto;
      background: #fff;
      border-radius: 8px;
      padding: 32px;
      box-shadow: 0 0 10px rgba(0, 0, 0, 0.05);
    }

    .logo {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .logo img {
      height: 24px;
    }

    .heading {
      font-size: 18px;
      margin: 24px 0 8px;
      font-weight: 700;
      color: #00C389;
    }

    .note {
      color: #666;
      margin-bottom: 20px;
      line-height: 1.6;
    }

    .footer-note {
      color: #444;
      margin: 40px 0 0;
    }

    .support {
      margin-top: 8px;
      text-decoration: underline;
    }

    .cta-box {
      margin-top: 40px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-radius: 8px;
      border: 1px solid #DCE1E8;
      overflow: hidden;
    }

    .cta-box figure {
      position: relative;
      top: 6px;
      padding: 0 20px;
      margin-left: auto;
    }

    .cta-box .text {
      font-weight: bold;
      font-size: 18px;
      color: #00CE86;
    }

    .cta-box button {
      padding: 10px 20px;
      background: #00C389;
      border: none;
      color: white;
      border-radius: 8px;
      cursor: pointer;
    }

    .social {
      margin-top: 30px;
      text-align: center;
    }

    .social>p {
      font-size: 10px;
      color: #697074;
    }

    .social img {
      width: 17px;
      vertical-align: middle;
    }

    .copyright {
      margin-top: 26px;
      font-size: 12px;
      color: #aaa;
      text-align: center;
    }

    .list-social {
      display: flex;
      align-items: center;
      justify-content: center;
      flex-wrap: wrap;
      gap: 8px;
    }

    .list-social li {
      border-radius: 300px;
      border: 1px solid #C3C3C3;
    }

    .list-social li a {
      display: flex;
      padding: 6px 20px;
      align-items: center;
      gap: 5px;
    }

    .list-social li a p {
      margin: 0;
      color: #000;
      font-size: 10px;
    }

    @media screen and (max-width: 767px) {
      .container {
        padding: 15px;
      }

      .cta-box {
        flex-wrap: wrap;
      }

      .cta-box div {
        margin: 0 auto;
        text-align: center;
      }

      .cta-box figure {
        padding: 0;
        margin: 0 auto;
      }

      .list-social li a {
        padding-left: 10px;
        padding-right: 10px;
      }
    }
  </style>
</head>

<body>
  <div class="container">
    <div class="logo">
      <img
