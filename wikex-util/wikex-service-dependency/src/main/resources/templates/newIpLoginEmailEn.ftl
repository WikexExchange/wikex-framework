            <p>Facebook</p>
          </a>
        </li>
        <li>
          <a href="https://www.linkedin.com/company/wikex/" target="_blank" rel="noreferrer">
            <img src="https://assets.kibble.exchange/tokens/linkedin.png" alt="Linkedin" />
